^src/SPTK/lib$
^src/Makevars$
# SPTK's own standalone build files: the R build compiles the SPTK sources
# listed in src/Makevars.in directly and never invokes these. They use GNU
# make extensions, which R CMD check rejects in shipped Makefiles.
^src/SPTK/Makefile$
^src/SPTK/tools/Makefile$
# Vendored test-framework header (Catch2), never compiled into the package.
^src/opensmile/progsrc/include/tests$

^src/ESTK$

^src/tcl-snack$

^src/opensmile/doc$
^src/opensmile/scripts$
^src/opensmile/example-audio$
